generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Job {
  id          String   @id @default(cuid())
  topicQuery  String
  status      String   @default("pending")
  rootNodeId  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  sources       Source[]
  nodes         Node[]
  events        ProgressEvent[]
  notebookPages NotebookPage[]
  messages      NotebookMessage[]
  candidates    CandidateTopic[]
  top3Ideas     Top3Ideas?

  @@index([status])
  @@index([createdAt])
}

model ProgressEvent {
  id        String   @id @default(cuid())
  jobId     String
  stage     String
  status    String
  message   String
  count     Int?
  timestamp BigInt
  createdAt DateTime @default(now())
  
  job       Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  
  @@index([jobId])
  @@index([createdAt])
}

model Source {
  id              String   @id @default(cuid())
  jobId           String
  type            String
  title           String
  url             String?
  publishedAt     DateTime?
  authorsJson     String?
  venue           String?
  snippet         String?
  externalId      String?
  reliabilityTier String
  createdAt       DateTime @default(now())
  
  job             Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  nodeSources     NodeSource[]
  entitySources   EntitySource[]
  
  @@index([jobId])
  @@index([type])
  @@index([reliabilityTier])
}

model Node {
  id                  String   @id @default(cuid())
  jobId               String
  parentId            String?
  label               String
  summary             String   @db.Text
  methodsJson         String?  @db.Text
  findingsJson        String?  @db.Text
  disagreementsJson   String?  @db.Text
  openProblemsJson    String?  @db.Text
  depth               Int      @default(0)
  createdAt           DateTime @default(now())
  
  job                 Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  parent              Node?    @relation("NodeChildren", fields: [parentId], references: [id], onDelete: Cascade)
  children            Node[]   @relation("NodeChildren")
  nodeSources         NodeSource[]
  
  @@index([jobId])
  @@index([parentId])
}

model NodeSource {
  id        String   @id @default(cuid())
  nodeId    String
  sourceId  String
  role      String
  createdAt DateTime @default(now())
  
  node      Node     @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  source    Source   @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  
  @@unique([nodeId, sourceId])
  @@index([nodeId])
  @@index([sourceId])
}

model NotebookPage {
  id        String   @id @default(cuid())
  jobId     String
  title     String
  content   String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  job       Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  messages  NotebookMessage[]
  
  @@index([jobId])
  @@index([createdAt])
}

model NotebookMessage {
  id            String   @id @default(cuid())
  jobId         String
  pageId        String?
  role          String   // 'user' | 'assistant'
  content       String   @db.Text
  citationsJson String?  @db.Text
  createdAt     DateTime @default(now())
  
  job           Job           @relation(fields: [jobId], references: [id], onDelete: Cascade)
  page          NotebookPage? @relation(fields: [pageId], references: [id], onDelete: Cascade)
  
  @@index([jobId])
  @@index([pageId])
  @@index([createdAt])
}

model CandidateTopic {
  id            String   @id @default(cuid())
  jobId         String
  label         String
  status        String   @default("active") // 'active' | 'archived' | 'selected'
  evidenceJson  String?  @db.Text
  score         Float?
  createdAt     DateTime @default(now())
  
  job           Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  
  @@index([jobId])
  @@index([status])
  @@index([createdAt])
}

model Top3Ideas {
  id          String   @id @default(cuid())
  jobId       String   @unique
  generatedAt DateTime @default(now())
  ideasJson   String   @db.Text
  traceJson   String?  @db.Text

  job         Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId])
}

// V3 — Experiments module (persisted claim sessions, domain-routed verification)

// A session is scoped to exactly one domain by construction — a claim's
// session determines its domain, so a math claim and a drug-discovery claim
// can never end up sharing context. This replaces the earlier groupId-based
// "linking" (see git history), which had no domain check and let any two
// claims in any two domains be linked together.
model ExperimentSession {
  id        String   @id @default(cuid())
  jobId     String // provenance only, like Experiment.jobId below — not an enforced FK
  domain    String // 'math' | 'physics' | 'chemistry' | 'biology' | 'drug_discovery'
  title     String? // user-editable; defaults to a snippet of the first claim if unset
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([jobId])
  @@index([domain])
}

// jobId is a provenance field only (like GraphEntity.jobId above), not an
// enforced foreign key: the standalone /experiments page uses a fixed
// pseudo-session id that isn't backed by a real Job row (see its page.tsx),
// so a hard FK would break that flow. Experiments made inside a real
// research job still get a real Job cuid here — it's just not constrained.
// sessionId is similarly provenance-style (not a hard FK) for consistency,
// but every claim's domain must match its session's domain — enforced at
// the API layer, not the database.
model Experiment {
  id          String   @id @default(cuid())
  jobId       String
  sessionId   String
  domain      String   // 'math' | 'physics' | 'chemistry' | 'biology' | 'drug_discovery'
  claim       String   @db.Text
  status      String   @default("draft") // 'draft' | 'ready' | 'formalizing' | 'verifying' | 'verified' | 'failed' | 'incomplete' | 'flagged' | 'error'
  resultJson  String?  @db.Text // domain-specific payload: Lean code/diagnostics for math, unit-check detail for physics, protocol flags/drug-likeness for chem/bio/drug_discovery
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([jobId])
  @@index([sessionId])
  @@index([domain])
}

model PaperSubscription {
  id           String   @id @default(cuid())
  email        String
  topic        String
  frequency    Int      @default(10)
  deliveryTime String   @default("09:00")
  unsubToken   String   @unique @default(cuid())
  createdAt    DateTime @default(now())

  @@index([email])
  @@index([topic])
}

// V3 — Persistent cross-run research graph (single source of truth)

model GraphEntity {
  id           String   @id @default(cuid())
  type         String   // 'topic' | 'hypothesis' | 'method' | 'evidence' | 'gap' | 'note'
  label        String
  content      String?  @db.Text
  jobId        String?  // provenance: run that produced it (survives job deletion)
  origin       String   @default("system") // 'system' (synced from a run) | 'user' (manually created)
  syncKey      String?  @unique // deterministic key for idempotent run-sync upserts
  metadataJson String?  @db.Text // e.g. {"noteType":"manual"} for notes
  pinned       Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  edgesFrom     GraphEdge[]    @relation("GraphEdgeFrom")
  edgesTo       GraphEdge[]    @relation("GraphEdgeTo")
  entitySources EntitySource[]

  @@index([type])
  @@index([jobId])
  @@index([origin])
}

model GraphEdge {
  id        String   @id @default(cuid())
  fromId    String
  toId      String
  type      String   // 'motivates' | 'provides' | 'uses_method' | 'contradicts' | 'reveals' | 'related_to' | 'notes_on'
  jobId     String?
  origin    String   @default("system")
  createdAt DateTime @default(now())

  from      GraphEntity @relation("GraphEdgeFrom", fields: [fromId], references: [id], onDelete: Cascade)
  to        GraphEntity @relation("GraphEdgeTo", fields: [toId], references: [id], onDelete: Cascade)

  @@unique([fromId, toId, type])
  @@index([fromId])
  @@index([toId])
  @@index([type])
}

model EntitySource {
  id        String   @id @default(cuid())
  entityId  String
  sourceId  String
  role      String   @default("supporting")
  createdAt DateTime @default(now())

  entity    GraphEntity @relation(fields: [entityId], references: [id], onDelete: Cascade)
  source    Source      @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@unique([entityId, sourceId])
  @@index([entityId])
  @@index([sourceId])
}
